{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "cviebrock/eloquent-sluggable": "^13.0",
        "darkaonline/l5-swagger": "^11.2",
        "google/cloud-translate": "^1.12",
        "guzzlehttp/guzzle": "^8.3",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^4.0",
        "pbmedia/laravel-ffmpeg": "^8.9",
        "robsontenorio/laravel-keycloak-guard": "^2.0",
        "spatie/laravel-translatable": "^6.15",
        "spatie/pdf-to-image": "^2.1"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^2.12",
        "fakerphp/faker": "^1.9",
        "laravel/dusk": "^8.7",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "phpunit/phpunit": "^12.5"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
